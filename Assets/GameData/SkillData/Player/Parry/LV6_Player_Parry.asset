  skillIcon: {fileID: 21300000, guid: 4e172c3d6cf32704e9db569f5138820d, type: 3}
  skillName: Parry
  skillDescription: 'Enable a magnetic field barrier for 0.5 seconds to parry incoming
    damage. <color=#FF5F1F><b>On a successful parry</b></color>, release a burst
    of Anergy in a <color=#FFD700><b>radius of 19.6 unit</b></color> around the ship,
    <color=#FF0000><b>dealing 102 damage</b></color> and applying <color=#CF9FFF>knockback</b></color>
    and <color=#CF9FFF>stun</b></color> to all enemies within the radius.

    

    <color=#CF9FFF><b>Knockback</b></color>
    : Push the enemy away by <color=#FFD700><b>13.2 units</b></color>.

    <color=#CF9FFF><b>Stun</b></color>
    : Unable to perform any actions for <color=#FFD700><b>0.5 seconds</b></color>.

    

    Cooldown:
    <color=#DBDBDB><b>3 sec</b></color>.'
